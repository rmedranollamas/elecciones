<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Elecciones 29-N 2026 · Predictor Estadístico LOREG Art. 163</title>
  <style>
    :root {
      --bg-paper: #faf9f5;
      --bg-card: #ffffff;
      --bg-subtle: #f3f0e8;
      --ink: #121212;
      --ink-muted: #57534e;
      --ink-soft: #78716c;
      --border: #dfd9ce;
      --border-strong: #1c1917;
      --accent: #0055a7;
      --accent-red: #b91c1c;
      --accent-green: #15803d;
      --accent-amber: #b45309;
      --font-serif: Georgia, "Liberation Serif", "Times New Roman", serif;
      --font-sans: system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      --font-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      --radius: 6px;
      --shadow-sm: 0 1px 2px rgba(18, 18, 18, 0.05);
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      background: var(--bg-paper);
      color: var(--ink);
      font-family: var(--font-sans);
      line-height: 1.48;
      -webkit-font-smoothing: antialiased;
    }

    .tabular { font-variant-numeric: tabular-nums; }
    .serif { font-family: var(--font-serif); }
    .muted { color: var(--ink-muted); }
    .mono { font-family: var(--font-mono); }

    /* Top Editorial Masthead */
    .masthead {
      background: var(--bg-card);
      border-bottom: 2px solid var(--border-strong);
      padding: 18px 20px 14px;
    }
    .masthead-inner, .container, .nav-inner {
      max-width: 1320px;
      margin: 0 auto;
    }
    .masthead-top {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
      border-bottom: 1px solid var(--border);
      padding-bottom: 10px;
      margin-bottom: 12px;
      font-size: 12px;
      color: var(--ink-muted);
      letter-spacing: 0.02em;
      text-transform: uppercase;
    }
    .masthead-badges { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
    .badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 3px 9px;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.03em;
      text-transform: uppercase;
      border: 1px solid var(--border);
      background: var(--bg-subtle);
      color: var(--ink);
    }
    .badge-ok { background: #dcfce7; border-color: #86efac; color: #166534; }
    .badge-blackout { background: #fee2e2; border-color: #fca5a5; color: #991b1b; }
    .badge-counterfactual { background: #fef3c7; border-color: #fcd34d; color: #92400e; }

    .masthead-main {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: flex-end;
      gap: 16px;
    }
    .masthead h1 {
      margin: 0;
      font-family: var(--font-serif);
      font-size: clamp(1.65rem, 3vw, 2.35rem);
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 1.12;
    }
    .masthead-sub {
      margin: 6px 0 0;
      font-size: 0.96rem;
      color: var(--ink-muted);
      max-width: 720px;
    }

    /* Controls strip */
    .control-bar {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      align-items: center;
    }
    .seg-group {
      display: inline-flex;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: var(--bg-subtle);
      padding: 2px;
      gap: 2px;
    }
    .seg-btn {
      border: 0;
      background: transparent;
      color: var(--ink-muted);
      font-family: var(--font-sans);
      font-size: 12px;
      font-weight: 600;
      padding: 5px 10px;
      border-radius: 4px;
      cursor: pointer;
      transition: background 0.15s, color 0.15s;
    }
    .seg-btn:hover { color: var(--ink); }
    .seg-btn.active {
      background: var(--border-strong);
      color: #ffffff;
    }

    /* Sticky Subnav */
    .subnav {
      position: sticky;
      top: 0;
      z-index: 40;
      background: rgba(250, 249, 245, 0.96);
      backdrop-filter: blur(6px);
      border-bottom: 1px solid var(--border);
      padding: 8px 20px;
    }
    .nav-inner {
      display: flex;
      gap: 16px;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .nav-inner::-webkit-scrollbar { display: none; }
    .nav-inner a {
      text-decoration: none;
      color: var(--ink-muted);
      font-size: 13px;
      font-weight: 600;
      white-space: nowrap;
      padding: 3px 0;
      border-bottom: 2px solid transparent;
    }
    .nav-inner a:hover { color: var(--ink); border-bottom-color: var(--border-strong); }

    .container { padding: 20px 20px 56px; }
    section { margin-top: 26px; }

    .section-head {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: baseline;
      gap: 10px;
      border-top: 2px solid var(--border-strong);
      padding-top: 10px;
      margin-bottom: 14px;
    }
    .section-head h2 {
      margin: 0;
      font-family: var(--font-serif);
      font-size: 1.38rem;
      font-weight: 700;
    }
    .section-head p {
      margin: 0;
      font-size: 0.88rem;
      color: var(--ink-muted);
    }

    .card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 16px 18px;
      box-shadow: var(--shadow-sm);
    }
    .card-title {
      margin: 0 0 10px;
      font-size: 0.95rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--ink-muted);
    }

    /* Hero KPI grid */
    .kpi-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 12px;
      margin-bottom: 14px;
    }
    .kpi-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 14px 16px;
      box-shadow: var(--shadow-sm);
    }
    .kpi-label {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--ink-muted);
      font-weight: 700;
    }
    .kpi-val {
      font-family: var(--font-serif);
      font-size: 1.75rem;
      font-weight: 700;
      margin: 4px 0 2px;
      line-height: 1.1;
    }
    .kpi-sub { font-size: 12px; color: var(--ink-muted); }

    .notice-banner {
      display: none;
      margin-bottom: 14px;
      padding: 10px 14px;
      border-radius: var(--radius);
      background: #fffbeb;
      border: 1px solid #fcd34d;
      color: #78350f;
      font-size: 13px;
    }
    .notice-banner.visible { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px; align-items: center; }

    /* Grid Layouts */
    .grid-2 {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      gap: 16px;
      align-items: start;
    }
    .grid-2-eq {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
      align-items: start;
    }
    @media (max-width: 980px) {
      .grid-2, .grid-2-eq { grid-template-columns: 1fr; }
    }

    /* Tables */
    .table-wrap { overflow-x: auto; }
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
    }
    th, td {
      padding: 7px 8px;
      border-bottom: 1px solid var(--border);
      text-align: left;
      vertical-align: middle;
    }
    th {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--ink-muted);
      font-weight: 700;
      background: var(--bg-subtle);
      white-space: nowrap;
    }
    th.num, td.num { text-align: right; font-variant-numeric: tabular-nums; }
    th.sortable { cursor: pointer; user-select: none; }
    th.sortable:hover { color: var(--ink); }
    tr:last-child td { border-bottom: 0; }
    tr.clickable { cursor: pointer; }
    tr.clickable:hover td { background: #f8f6f0; }

    .party-chip {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-weight: 700;
    }
    .dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      flex-shrink: 0;
      border: 1px solid rgba(0,0,0,0.12);
    }

    /* Spark range bar */
    .range-track {
      position: relative;
      height: 8px;
      background: #ece8df;
      border-radius: 999px;
      width: 84px;
      display: inline-block;
      vertical-align: middle;
      margin-left: 6px;
    }
    .range-band {
      position: absolute;
      top: 1px;
      bottom: 1px;
      border-radius: 999px;
      opacity: 0.35;
    }
    .range-mid {
      position: absolute;
      top: -1px;
      bottom: -1px;
      width: 3px;
      border-radius: 2px;
    }

    /* Hemicycle */
    .svg-box { position: relative; width: 100%; }
    .svg-box svg { width: 100%; height: auto; display: block; }
    .majority-bar {
      margin-top: 8px;
      height: 12px;
      background: #ece8df;
      border-radius: 999px;
      position: relative;
      overflow: hidden;
      display: flex;
    }
    .majority-mid {
      position: relative;
      height: 18px;
      margin-top: -15px;
      pointer-events: none;
    }
    .majority-mid-line {
      position: absolute;
      left: 50%;
      top: 0;
      bottom: 0;
      width: 2px;
      background: var(--border-strong);
    }
    .legend-row {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      font-size: 12px;
      color: var(--ink-muted);
      margin-top: 8px;
    }
    .legend-item { display: inline-flex; align-items: center; gap: 5px; }

    /* Cartogram */
    .cartogram-grid {
      display: grid;
      grid-template-columns: repeat(10, minmax(0, 1fr));
      gap: 5px;
      margin-top: 10px;
    }
    .tile {
      border-radius: 5px;
      padding: 5px 4px;
      min-height: 52px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      cursor: pointer;
      border: 2px solid transparent;
      transition: transform 0.1s, border-color 0.12s, box-shadow 0.12s;
      user-select: none;
      overflow: hidden;
    }
    .tile:hover { transform: translateY(-1px); box-shadow: 0 3px 8px rgba(0,0,0,0.16); }
    .tile.selected { border-color: #111827; box-shadow: 0 0 0 2px #faf9f5 inset, 0 4px 10px rgba(0,0,0,0.22); }
    .tile-name { font-size: 10px; font-weight: 700; line-height: 1.05; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .tile-bottom { display: flex; justify-content: space-between; align-items: baseline; gap: 2px; margin-top: 3px; }
    .tile-seats { font-size: 12px; font-weight: 800; font-variant-numeric: tabular-nums; }
    .tile-tag { font-size: 9.5px; font-weight: 700; opacity: 0.92; font-variant-numeric: tabular-nums; }
    @media (max-width: 720px) {
      .cartogram-grid { gap: 3px; }
      .tile { min-height: 40px; padding: 3px; }
      .tile-name { font-size: 8.5px; }
      .tile-seats { font-size: 10px; }
      .tile-tag { display: none; }
    }

    /* Quotient bars */
    .q-row { display: grid; grid-template-columns: 78px 1fr 70px; gap: 8px; align-items: center; margin: 4px 0; font-size: 12px; }
    .q-track { height: 14px; background: #f1eee7; border-radius: 3px; position: relative; overflow: hidden; }
    .q-fill { height: 100%; border-radius: 3px; }
    .q-won { opacity: 0.95; }
    .q-lost { opacity: 0.35; background-image: repeating-linear-gradient(45deg, transparent, transparent 4px, rgba(255,255,255,0.45) 4px, rgba(255,255,255,0.45) 8px); }

    /* Tooltip */
    .chart-tooltip {
      position: fixed;
      z-index: 100;
      pointer-events: none;
      background: rgba(18, 18, 18, 0.94);
      color: #ffffff;
      border-radius: 6px;
      padding: 8px 11px;
      font-size: 12px;
      line-height: 1.38;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25);
      max-width: 280px;
      display: none;
    }

    /* Trend legend toggles */
    .chip-toggles { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 10px; }
    .party-toggle {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 9px;
      font-size: 12px;
      font-weight: 600;
      border: 1px solid var(--border);
      border-radius: 999px;
      background: var(--bg-card);
      cursor: pointer;
      color: var(--ink);
    }
    .party-toggle.off { opacity: 0.42; background: var(--bg-subtle); }

    /* What-if sliders & Pact 3-state */
    .slider-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
      gap: 10px 14px;
    }
    .slider-item {
      border: 1px solid var(--border);
      border-radius: 5px;
      padding: 8px 10px;
      background: #fcfbf8;
    }
    .slider-top {
      display: flex;
      justify-content: space-between;
      font-size: 12.5px;
      font-weight: 700;
      margin-bottom: 4px;
    }
    .slider-item input[type="range"] { width: 100%; accent-color: var(--border-strong); cursor: pointer; }

    .pact-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 5px 0;
      border-bottom: 1px solid var(--border);
      font-size: 13px;
      gap: 8px;
    }
    .pact-row:last-child { border-bottom: 0; }
    .tri-pill {
      display: inline-flex;
      border: 1px solid var(--border);
      border-radius: 4px;
      overflow: hidden;
      flex-shrink: 0;
    }
    .tri-btn {
      border: 0;
      background: #ffffff;
      color: var(--ink-muted);
      font-size: 11px;
      font-weight: 700;
      padding: 3px 8px;
      cursor: pointer;
    }
    .tri-btn.yes.active { background: #15803d; color: #fff; }
    .tri-btn.abs.active { background: #d97706; color: #fff; }
    .tri-btn.no.active { background: #b91c1c; color: #fff; }

    .btn-outline {
      border: 1px solid var(--border-strong);
      background: var(--bg-card);
      color: var(--ink);
      border-radius: 4px;
      padding: 5px 10px;
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
    }
    .btn-outline:hover { background: var(--bg-subtle); }

    .grade-pill {
      display: inline-block;
      min-width: 22px;
      text-align: center;
      padding: 1px 6px;
      border-radius: 4px;
      font-size: 11px;
      font-weight: 800;
    }
    .grade-A { background: #dcfce7; color: #166534; }
    .grade-B { background: #dbeafe; color: #1e40af; }
    .grade-C { background: #fee2e2; color: #991b1b; }

    .search-box {
      padding: 6px 10px;
      border: 1px solid var(--border);
      border-radius: 4px;
      font-size: 13px;
      font-family: var(--font-sans);
      min-width: 220px;
    }

    footer {
      border-top: 2px solid var(--border-strong);
      padding: 20px;
      margin-top: 32px;
      font-size: 12.5px;
      color: var(--ink-muted);
      background: var(--bg-card);
    }
  </style>
</head>
<body>
  <header class="masthead">
    <div class="masthead-inner">
      <div class="masthead-top">
        <div class="masthead-badges">
          <span>ESPAÑA · ELECCIONES GENERALES 29-N (2026)</span>
          <span class="badge">Cortes {{ metadata.as_of_date }}</span>
          <span class="badge">52 circunscripciones · 350 escaños</span>
          <span class="badge">{{ "{:,}".format(metadata.n_sims).replace(",", ".") }} simulaciones ({{ metadata.simulation_runtime_ms }} ms)</span>
        </div>
        <div class="masthead-badges">
          {% if metadata.blackout_active or metadata.live_blackout_active %}
          <span class="badge badge-blackout">Veda Electoral Art. 69.7 LOREG activa</span>
          {% else %}
          <span class="badge badge-ok">Ventana pre-veda activa (hasta 23-N)</span>
          {% endif %}
        </div>
      </div>

      <div class="masthead-main">
        <div>
          <h1>Radiografía probabilística del Congreso 29-N</h1>
          <p class="masthead-sub">
            Modelo jerárquico bayesiano-frecuentista calibrado fuera de muestra (2015–2023) con desagregación provincial IPF bajo candidatura oficial del BOE, D'Hondt exacto LOREG Art. 163 y simulación de investidura Art. 99 CE.
          </p>
        </div>
        <div class="control-bar" aria-label="Controles de modelo">
          <div>
            <div style="font-size:10.5px;font-weight:700;color:var(--ink-muted);margin-bottom:3px;text-transform:uppercase;">Motor Etapa 1</div>
            <div class="seg-group" id="engine-toggle">
              <button class="seg-btn active" data-engine="ensemble">Ensemble</button>
              <button class="seg-btn" data-engine="kernel">Kernel</button>
              <button class="seg-btn" data-engine="state_space">Espacio-Estado</button>
            </div>
          </div>
          <div>
            <div style="font-size:10.5px;font-weight:700;color:var(--ink-muted);margin-bottom:3px;text-transform:uppercase;">Sensibilidad CIS</div>
            <div class="seg-group" id="cis-toggle">
              <button class="seg-btn active" data-cis="with">Con CIS</button>
              <button class="seg-btn" data-cis="without">Sin CIS</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </header>

  <nav class="subnav" aria-label="Navegación de secciones">
    <div class="nav-inner">
      <a href="#sec-resumen">Resumen y Hemiciclo</a>
      <a href="#sec-cartograma">Mapa Provincial &amp; D'Hondt</a>
      <a href="#sec-tendencia">Tendencia de Encuestas</a>
      <a href="#sec-whatif">Simulador "What-If" &amp; Art. 99</a>
      <a href="#sec-encuestadoras">Encuestadoras &amp; Sesgos</a>
      <a href="#sec-backtest">Validación Histórica (LOOCV)</a>
    </div>
  </nav>

  <main class="container">
    <div id="mode-notice" class="notice-banner" role="status">
      <span id="mode-notice-text"></span>
      <button class="btn-outline" id="btn-reset-mode" type="button">Volver al escenario Monte Carlo base</button>
    </div>

    <!-- SECTION 1: HERO KPIs & HEMICYCLE -->
    <section id="sec-resumen">
      <div class="kpi-grid" id="hero-kpis">
        {% for p in top_parties[:3] %}
        <div class="kpi-card">
          <div class="kpi-label">{{ p.short_name }} (Media simulada)</div>
          <div class="kpi-val tabular">{{ p.median }} escaños</div>
          <div class="kpi-sub tabular">{{ p.vote_pct }}% voto · 80%: {{ p.p10 }}–{{ p.p90 }}</div>
        </div>
        {% endfor %}
        <div class="kpi-card">
          <div class="kpi-label">PP + Vox (&ge; 176) · Bloqueo Art. 99.5</div>
          <div class="kpi-val tabular">{{ "%.1f"|format(investiture.first_ballot.pp_vox.prob * 100) if investiture.first_ballot.pp_vox else "—" }}%</div>
          <div class="kpi-sub tabular">Bloqueo institucional: {{ "%.1f"|format(investiture.deadlock_prob * 100) }}%</div>
        </div>
      </div>

      <div class="grid-2">
        <div class="card">
          <h3 class="card-title">Hemiciclo del Congreso (350 escaños · Mayoría 176)</h3>
          <div class="svg-box" id="hemicycle-box">
            <svg id="hemicycle-svg" viewBox="0 0 760 405" role="img" aria-label="Hemiciclo de 350 escaños del Congreso de los Diputados"></svg>
          </div>
          <div class="majority-bar" id="majority-bar" title="Distribución izquierda-derecha (línea central = 176 escaños)"></div>
          <div class="majority-mid"><div class="majority-mid-line"></div></div>
          <div class="legend-row" style="justify-content:space-between;margin-top:4px;">
            <span class="legend-item">← Mayoría izquierda/plurinacional</span>
            <span class="legend-item"><strong>176 mayoría absoluta</strong></span>
            <span class="legend-item">Mayoría derecha →</span>
          </div>
          <div class="legend-row" id="tier-legend">
            <span class="legend-item"><span class="dot" style="background:#374151;"></span> Seguro (&ge;99%): <strong id="t-seg">{{ tier_totals.seguros }}</strong></span>
            <span class="legend-item"><span class="dot" style="background:#374151;opacity:0.65;"></span> Probable (75–99%): <strong id="t-prob">{{ tier_totals.probables }}</strong></span>
            <span class="legend-item"><span class="dot" style="background:#fff;border:2px solid #374151;"></span> En juego (25–75%): <strong id="t-juego">{{ tier_totals.en_juego }}</strong></span>
          </div>
        </div>

        <div class="card">
          <div style="display:flex;justify-content:space-between;align-items:baseline;gap:8px;flex-wrap:wrap;">
            <h3 class="card-title" style="margin-bottom:8px;">Proyección Nacional de Votos y Escaños</h3>
            <span class="muted tabular" style="font-size:12px;" id="nat-table-subtitle">Monte Carlo 50.000 tiradas</span>
          </div>
          <div class="table-wrap">
            <table id="national-table">
              <thead>
                <tr>
                  <th>Partido</th>
                  <th class="num">Voto % (P10–P90)</th>
                  <th class="num">Media</th>
                  <th class="num">Rango 80%</th>
                  <th class="num">Seg</th>
                  <th class="num">Prob</th>
                  <th class="num">Jue</th>
                </tr>
              </thead>
              <tbody></tbody>
            </table>
          </div>
