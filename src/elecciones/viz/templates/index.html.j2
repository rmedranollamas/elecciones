  <footer>
    <div class="masthead-inner" style="display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px;">
      <div>
        <strong>elecciones 29-N</strong> · Generado sin dependencias externas el {{ metadata.generated_at }} (corte de datos {{ metadata.as_of_date }}).
        Regla LOREG Art. 163 (barrera 3% incluyendo voto en blanco; Ceuta y Melilla mayoría simple) &amp; Art. 69.7 veda demoscópica (24–29 nov 2026 CET).
      </div>
      <div class="mono">Seed: {{ metadata.seed }} · Engine: {{ metadata.engine }}</div>
    </div>
  </footer>

  <div class="chart-tooltip" id="tooltip"></div>

  <script id="elecciones-data" type="application/json">{{ payload_json | safe }}</script>
  <script>
    (function () {
      "use strict";

      const DATA = JSON.parse(document.getElementById("elecciones-data").textContent);
      const PARTY_META = DATA.national.party_meta || {};
      const CONST_META = DATA.national.constituency_meta || {};
      const STAGE1_CMP = DATA.national.stage1_comparison || {};
      const CIS_SENS = DATA.national.cis_sensitivity || {};

      const RIGHT_PARTIES = new Set(["PP", "UPN_PP", "VOX", "SALF", "AC"]);
      const LEFT_PARTIES = new Set(["PSOE", "FA", "PODEMOS", "COMPROMIS_FV", "UPC", "ARA_MES", "ADELANTE", "ERC", "EH_BILDU", "BNG"]);
      const HEMICYCLE_ORDER = [
        "ADELANTE", "PODEMOS", "EH_BILDU", "FA", "COMPROMIS_FV", "ARA_MES", "UPC",
        "BNG", "ERC", "PSOE", "TERUEL_EXISTE", "SORIA_YA", "GEROA_BAI",
        "PACMA", "FO", "ALHORA", "OTROS", "PNV", "JUNTS", "CCA", "UPN_PP", "PP", "VOX", "SALF", "AC", "CUP", "UPL"
      ];

      const STATE = {
        engine: DATA.metadata.engine || "ensemble",
        cis: DATA.metadata.exclude_cis_headline ? "without" : "with",
        mapMode: "winner",
        selectedCpro: "26",
        hiddenTrendParties: new Set(),
        pollsterFilter: "",
        pollsterSortKey: "shrunk_mae",
        pollsterSortAsc: true,
        btHorizon: "global",
        swings: {},
        pactVotes: {
          PP: "yes", UPN_PP: "yes", VOX: "yes", CCA: "abs", SALF: "no",
          PSOE: "no", FA: "no", PODEMOS: "no", ERC: "no", JUNTS: "no",
          PNV: "no", EH_BILDU: "no", BNG: "no", COMPROMIS_FV: "no", ADELANTE: "no", UPC: "no", OTROS: "no"
        }
      };

      const BASE_ENGINE = DATA.metadata.engine || "ensemble";
      const BASE_CIS = DATA.metadata.exclude_cis_headline ? "without" : "with";
      const SLIDER_PARTIES = ["PP", "PSOE", "VOX", "FA", "PODEMOS", "SALF", "COMPROMIS_FV", "ADELANTE", "ERC", "JUNTS", "PNV", "EH_BILDU"];
      SLIDER_PARTIES.forEach(p => { STATE.swings[p] = 0.0; });

      // If La Rioja not in top battlegrounds, default to top battleground
      if (DATA.battlegrounds && DATA.battlegrounds.length > 0) {
        STATE.selectedCpro = DATA.battlegrounds[0].cpro;
      } else {
        STATE.selectedCpro = "28";
      }

      const tooltip = document.getElementById("tooltip");
      function showTip(evt, html) {
        tooltip.innerHTML = html;
        tooltip.style.display = "block";
        const x = Math.min(window.innerWidth - 295, evt.clientX + 14);
        const y = Math.min(window.innerHeight - 120, evt.clientY + 14);
        tooltip.style.left = Math.max(8, x) + "px";
        tooltip.style.top = Math.max(8, y) + "px";
      }
      function hideTip() { tooltip.style.display = "none"; }

      function esc(str) {
        return String(str == null ? "" : str)
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;");
      }
      function pMeta(pid) {
        return PARTY_META[pid] || { short_name: pid, name: pid, color: "#64748B", bloc: "other" };
      }
      function pColor(pid) { return pMeta(pid).color || "#64748B"; }
      function pShort(pid) { return pMeta(pid).short_name || pid; }
      function contrastInk(hex) {
        const h = (hex || "#64748B").replace("#", "");
        if (h.length !== 6) return "#FFFFFF";
        const r = parseInt(h.slice(0, 2), 16), g = parseInt(h.slice(2, 4), 16), b = parseInt(h.slice(4, 6), 16);
        return (0.299 * r + 0.587 * g + 0.114 * b) > 158 ? "#111827" : "#FFFFFF";
      }
      function fmtPct(unitVal, digits = 1) { return (Number(unitVal || 0) * 100).toFixed(digits) + "%"; }
      function fmtNum(val, digits = 1) { return Number(val || 0).toFixed(digits); }
      function fmtInt(val) { return Math.round(Number(val || 0)).toLocaleString("es-ES"); }

      // LOREG Art. 163 exact client-side D'Hondt solver (provincial 3% over valid incl. blank; Ceuta/Melilla plurality)
      function allocateDistrictDhondt(seats, partyVotesObj, blankVotes, isCity) {
        let valid = Number(blankVotes || 0);
        const entries = [];
        for (const [p, vRaw] of Object.entries(partyVotesObj)) {
          const v = Number(vRaw || 0);
          if (v > 0) {
            valid += v;
            entries.push([p, v]);
          }
        }
        const alloc = {};
        if (valid <= 0 || entries.length === 0) return alloc;
        const elig = entries.filter(([, v]) => (isCity ? v > 0 : (v / valid) >= 0.03));
        if (elig.length === 0) return alloc;
        if (isCity) {
          elig.sort((a, b) => (b[1] - a[1]) || a[0].localeCompare(b[0]));
          alloc[elig[0][0]] = seats;
          return alloc;
        }
        for (const [p] of elig) alloc[p] = 0;
        for (let k = 0; k < seats; k++) {
          let bestP = elig[0][0];
          let bestQ = -1;
          let bestV = -1;
          for (const [p, v] of elig) {
            const q = v / (alloc[p] + 1);
            if (q > bestQ || (q === bestQ && v > bestV)) {
              bestQ = q;
              bestV = v;
              bestP = p;
            }
          }
          alloc[bestP] += 1;
        }
        return alloc;
      }

      // Apply national vote-share multiplier shift cleanly onto masked 52 districts & run D'Hondt
      function solveShiftedChamber(multipliers) {
        const natSeats = {};
        const natVotes = {};
        let totValid = 0;
        const distResults = [];

        for (const con of DATA.constituencies) {
          const isCity = con.cpro === "51" || con.cpro === "52";
          const candRaw = {};
          let candSum = 0;
          for (const [p, s] of Object.entries(con.final_shares)) {
            if (s <= 0) continue;
            const mult = multipliers[p] !== undefined ? multipliers[p] : 1.0;
            const adj = Math.max(0.0001, s * mult);
            candRaw[p] = adj;
            candSum += adj;
          }
          const targetSum = Math.max(0.85, 1.0 - con.blank_share);
          const normShares = {};
          for (const [p, adj] of Object.entries(candRaw)) {
            normShares[p] = candSum > 0 ? (adj / candSum) * targetSum : 0;
          }
          const dSeats = allocateDistrictDhondt(con.seats_2026, normShares, con.blank_share, isCity);
          const w = con.validos_prior || 100000;
          totValid += w;
          for (const [p, s] of Object.entries(normShares)) {
            natVotes[p] = (natVotes[p] || 0) + s * w;
          }
          for (const [p, sc] of Object.entries(dSeats)) {
            natSeats[p] = (natSeats[p] || 0) + sc;
          }
          distResults.push({ cpro: con.cpro, seats: dSeats, shares: normShares });
        }
        const natShares = {};
        for (const [p, vw] of Object.entries(natVotes)) {
          natShares[p] = totValid > 0 ? vw / totValid : 0;
        }
        return { natSeats, natShares, distResults };
      }

      function computeEngineCisMultipliers() {
        const mult = {};
        const baseStage = STAGE1_CMP[BASE_ENGINE] || { mean_shares: {} };
        const curStage = STAGE1_CMP[STATE.engine] || baseStage;
        const engShares = curStage.mean_shares || {};
        const baseEngShares = baseStage.mean_shares || {};

        const cisBase = CIS_SENS[BASE_CIS === "without" ? "without_cis" : "with_cis"] || { mean_shares: {} };
        const cisCur = CIS_SENS[STATE.cis === "without" ? "without_cis" : "with_cis"] || cisBase;

        for (const pid of DATA.party_order) {
          const bE = Number(baseEngShares[pid] || 0);
          const cE = Number(engShares[pid] || bE);
          const rE = bE > 0.002 ? cE / bE : 1.0;

          const bC = Number((cisBase.mean_shares || {})[pid] || 0);
          const cC = Number((cisCur.mean_shares || {})[pid] || bC);
          const rC = bC > 0.002 ? cC / bC : 1.0;

          mult[pid] = Math.max(0.25, Math.min(3.0, rE * rC));
        }
        return mult;
      }

      function isCounterfactualMode() {
        return STATE.engine !== BASE_ENGINE || STATE.cis !== BASE_CIS;
      }

      // Largest-remainder rounding of expected seats summing strictly to 350 for Hemicycle
      function hamiltonSeats350(seatEntries) {
        const floors = seatEntries.map(([p, mean]) => ({
          p,
          base: Math.floor(mean),
          rem: mean - Math.floor(mean),
        }));
        let remSeats = 350 - floors.reduce((a, b) => a + b.base, 0);
        const byRem = [...floors].sort((a, b) => b.rem - a.rem || a.p.localeCompare(b.p));
        let idx = 0;
        while (remSeats > 0 && idx < byRem.length) {
          byRem[idx].base += 1;
          remSeats -= 1;
          idx += 1;
        }
        const out = {};
        floors.forEach(item => { out[item.p] = item.base; });
        return out;
      }

      // Build fixed 350 hemicycle coordinates across 7 concentric arcs
      const HEMI_COORDS = (function () {
        const counts = [33, 39, 45, 51, 56, 61, 65];
        const radii = [126, 154, 182, 210, 238, 266, 294];
        const cx = 380, cy = 368;
        const pts = [];
        for (let row = 0; row < counts.length; row++) {
          const n = counts[row];
          const r = radii[row];
          for (let i = 0; i < n; i++) {
            const theta = n > 1 ? Math.PI - (Math.PI * i) / (n - 1) : Math.PI / 2;
            pts.push({
              x: cx + r * Math.cos(theta),
              y: cy - r * Math.sin(theta),
              theta,
              row,
            });
          }
        }
        pts.sort((a, b) => b.theta - a.theta || a.row - b.row);
        return pts;
      })();

      function renderHemicycleAndNational() {
        const cf = isCounterfactualMode();
        const noticeEl = document.getElementById("mode-notice");
        const noticeText = document.getElementById("mode-notice-text");
        if (cf) {
          noticeText.innerHTML =
            `<strong>Vista contrafactual activa</strong> (${esc(STATE.engine.toUpperCase())}, ${STATE.cis === "with" ? "Con CIS" : "Sin CIS"}): los escaños se recalculan al instante aplicando la regla D'Hondt sobre las 52 circunscripciones a partir de la desviación de Etapa 1.`;
          noticeEl.classList.add("visible");
        } else {
          noticeEl.classList.remove("visible");
        }

        const seatsMap = DATA.national.seats;
        const vsMap = DATA.national.vote_shares;
        let displayRows = [];
        let tierSums = { seg: 0, prob: 0, jue: 0 };

        if (!cf) {
          for (const pid of DATA.party_order) {
            const sObj = seatsMap[pid];
            const vs = vsMap[pid];
            if (!sObj || (sObj.p95 === 0 && vs.mean < 0.004)) continue;
            tierSums.seg += sObj.seguros;
            tierSums.prob += sObj.probables;
            tierSums.jue += sObj.en_juego;
            displayRows.push({
              pid,
              vsMean: vs.mean,
              vsP10: vs.p10,
              vsP90: vs.p90,
              sMean: sObj.mean,
              sMed: sObj.median,
              sP10: sObj.p10,
              sP90: sObj.p90,
              seg: sObj.seguros,
              prob: sObj.probables,
              jue: sObj.en_juego,
            });
          }
          document.getElementById("nat-table-subtitle").textContent =
            `Monte Carlo ${fmtInt(DATA.metadata.n_sims)} tiradas · ${DATA.metadata.engine}`;
        } else {
          const mult = computeEngineCisMultipliers();
          const solved = solveShiftedChamber(mult);
          for (const pid of DATA.party_order) {
            const sh = solved.natShares[pid] || 0;
            const sc = solved.natSeats[pid] || 0;
            if (sc === 0 && sh < 0.004) continue;
            tierSums.seg += sc;
            displayRows.push({
              pid,
              vsMean: sh,
              vsP10: sh,
              vsP90: sh,
              sMean: sc,
              sMed: sc,
              sP10: sc,
              sP90: sc,
              seg: sc,
              prob: 0,
              jue: 0,
            });
          }
          displayRows.sort((a, b) => b.sMean - a.sMean || b.vsMean - a.vsMean);
          document.getElementById("nat-table-subtitle").textContent =
            `Reparto D'Hondt determinista (${STATE.engine}, ${STATE.cis === "with" ? "con CIS" : "sin CIS"})`;
        }

        document.getElementById("t-seg").textContent = tierSums.seg;
        document.getElementById("t-prob").textContent = tierSums.prob;
        document.getElementById("t-juego").textContent = tierSums.jue;

        // National table body
        const tbody = document.querySelector("#national-table tbody");
        const maxVs = Math.max(0.35, ...displayRows.map(r => r.vsP90));
        tbody.innerHTML = displayRows.map(r => {
          const col = pColor(r.pid);
          const lPct = Math.min(100, (r.vsP10 / maxVs) * 100);
          const wPct = Math.max(3, Math.min(100 - lPct, ((r.vsP90 - r.vsP10) / maxVs) * 100));
          const mPct = Math.min(98, (r.vsMean / maxVs) * 100);
          return `
            <tr>
              <td><span class="party-chip"><span class="dot" style="background:${col}"></span>${esc(pShort(r.pid))}</span></td>
              <td class="num">
                <strong>${fmtPct(r.vsMean, 1)}</strong>
                <span class="muted">(${fmtPct(r.vsP10, 1)}–${fmtPct(r.vsP90, 1)})</span>
                <span class="range-track" title="80%: ${fmtPct(r.vsP10, 1)} – ${fmtPct(r.vsP90, 1)}">
                  <span class="range-band" style="left:${lPct}%;width:${wPct}%;background:${col}"></span>
                  <span class="range-mid" style="left:${mPct}%;background:${col}"></span>
                </span>
              </td>
              <td class="num"><strong>${cf ? r.sMed : fmtNum(r.sMean, 1)}</strong></td>
              <td class="num">${r.sP10 === r.sP90 ? r.sMed : `${r.sP10}–${r.sP90}`}</td>
              <td class="num">${r.seg}</td>
              <td class="num">${cf ? "—" : r.prob}</td>
              <td class="num">${cf ? "—" : r.jue}</td>
            </tr>
          `;
        }).join("");

        // CIS sensitivity compact comparison footer
        const strip = document.getElementById("cis-diff-strip");
        const wCis = (CIS_SENS.with_cis || {}).mean_shares || {};
        const woCis = (CIS_SENS.without_cis || {}).mean_shares || {};
        const keyP = ["PP", "PSOE", "VOX", "FA", "PODEMOS", "SALF"];
        strip.innerHTML = `<strong>Impacto CIS en voto nacional (Con CIS vs Sin CIS):</strong> ` +
          keyP.filter(p => p in wCis && p in woCis).map(p => {
            const diff = (wCis[p] - woCis[p]) * 100;
            const sign = diff >= 0 ? "+" : "";
            return `<span style="margin-right:10px;white-space:nowrap;">${esc(pShort(p))}: <strong class="tabular">${sign}${diff.toFixed(2)} pp</strong></span>`;
          }).join("");

        // Refresh Hero KPI strip cleanly for active mode
        const heroEl = document.getElementById("hero-kpis");
        if (heroEl) {
          const byId = Object.fromEntries(displayRows.map(r => [r.pid, r]));
          const ppR = byId.PP || { sMed: 0, vsMean: 0, sP10: 0, sP90: 0 };
          const psR = byId.PSOE || { sMed: 0, vsMean: 0, sP10: 0, sP90: 0 };
          const vxR = byId.VOX || { sMed: 0, vsMean: 0, sP10: 0, sP90: 0 };
          const upnR = byId.UPN_PP || { sMed: 0 };
          const rightMed = (ppR.sMed || 0) + (vxR.sMed || 0) + (upnR.sMed || 0);
          const ppVxProb = ((((DATA.investiture || {}).first_ballot || {}).pp_vox || {}).prob || 0) * 100;
          const deadProb = ((DATA.investiture || {}).deadlock_prob || 0) * 100;
          const cards = [
            ["PP (Escaños)", `${ppR.sMed} escaños`, `${fmtPct(ppR.vsMean, 1)} voto · ${cf ? "Contrafactual" : `80%: ${ppR.sP10}–${ppR.sP90}`}`],
            ["PSOE (Escaños)", `${psR.sMed} escaños`, `${fmtPct(psR.vsMean, 1)} voto · ${cf ? "Contrafactual" : `80%: ${psR.sP10}–${psR.sP90}`}`],
            ["Vox (Escaños)", `${vxR.sMed} escaños`, `${fmtPct(vxR.vsMean, 1)} voto · ${cf ? "Contrafactual" : `80%: ${vxR.sP10}–${vxR.sP90}`}`],
            [cf ? "PP + UPN + Vox (Contrafactual)" : "PP + Vox (≥ 176) · Bloqueo Art. 99.5", cf ? `${rightMed} escaños` : `${ppVxProb.toFixed(1)}%`, cf ? (rightMed >= 176 ? "Alcanza mayoría absoluta (≥176)" : `A ${176 - rightMed} escaños de mayoría`) : `Bloqueo institucional: ${deadProb.toFixed(1)}%`],
          ];
          heroEl.innerHTML = cards.map(([lbl, val, sub]) => `
            <div class="kpi-card">
              <div class="kpi-label">${esc(lbl)}</div>
              <div class="kpi-val tabular">${esc(val)}</div>
              <div class="kpi-sub tabular">${esc(sub)}</div>
            </div>
          `).join("");
        }

        // Render Hemicycle SVG + Majority Bar
        drawHemicycleFromRows(displayRows, cf);
      }

      function drawHemicycleFromRows(rows, isDeterministic) {
        const svg = document.getElementById("hemicycle-svg");
        const hemiCounts = hamiltonSeats350(rows.map(r => [r.pid, r.sMean]));
        const orderedParties = [...HEMICYCLE_ORDER];
        rows.forEach(r => { if (!orderedParties.includes(r.pid)) orderedParties.push(r.pid); });

        const rowLookup = {};
        rows.forEach(r => { rowLookup[r.pid] = r; });

        const seatTokens = [];
        for (const pid of orderedParties) {
          const n = hemiCounts[pid] || 0;
          if (n <= 0) continue;
          const info = rowLookup[pid] || { seg: n, prob: 0, jue: 0 };
          const col = pColor(pid);
          if (isDeterministic) {
            for (let i = 0; i < n; i++) seatTokens.push({ pid, col, tier: "Simulado", idx: i + 1, tot: n });
          } else {
            // Order party seats safely: Seguro -> Probable -> En juego from left/center edges
            const nSeg = Math.min(n, info.seg || 0);
            const nProb = Math.min(n - nSeg, info.prob || 0);
            const isRight = RIGHT_PARTIES.has(pid);
            const arr = [];
            for (let i = 0; i < n; i++) {
              let tier = "En juego";
              if (i < nSeg) tier = "Seguro";
              else if (i < nSeg + nProb) tier = "Probable";
              arr.push({ pid, col, tier, idx: i + 1, tot: n });
            }
            if (isRight) arr.reverse();
            seatTokens.push(...arr);
          }
        }

        let html = `<line x1="380" y1="54" x2="380" y2="375" stroke="#1c1917" stroke-width="1.5" stroke-dasharray="4 4" opacity="0.55" />`;
        html += `<text x="380" y="44" text-anchor="middle" font-size="11" font-weight="700" fill="#57534e">176</text>`;

        for (let i = 0; i < HEMI_COORDS.length; i++) {
          const pt = HEMI_COORDS[i];
          const tok = seatTokens[i] || { pid: "OTROS", col: "#9ca3af", tier: "Seguro", idx: 1, tot: 1 };
          let fillOp = "0.96";
          let stroke = "none";
          let sw = "0";
          if (tok.tier === "Probable") {
            fillOp = "0.62";
            stroke = tok.col;
            sw = "1.1";
          } else if (tok.tier === "En juego") {
            fillOp = "0.22";
            stroke = tok.col;
            sw = "1.8";
          }
          html += `<circle class="seat-dot" data-pid="${esc(tok.pid)}" data-tier="${esc(tok.tier)}" data-idx="${tok.idx}" data-tot="${tok.tot}" cx="${pt.x.toFixed(1)}" cy="${pt.y.toFixed(1)}" r="7.4" fill="${tok.col}" fill-opacity="${fillOp}" stroke="${stroke}" stroke-width="${sw}" />`;
        }

        const totalShown = seatTokens.length;
        html += `<text x="380" y="340" text-anchor="middle" font-family="Georgia,serif" font-size="30" font-weight="700" fill="#121212">${totalShown}</text>`;
        html += `<text x="380" y="362" text-anchor="middle" font-size="12" fill="#57534e">escaños · Congreso 29-N</text>`;
        svg.innerHTML = html;

        svg.querySelectorAll(".seat-dot").forEach(el => {
          el.addEventListener("mouseenter", evt => {
            const pid = el.getAttribute("data-pid");
            const tier = el.getAttribute("data-tier");
            const idx = el.getAttribute("data-idx");
            const tot = el.getAttribute("data-tot");
            showTip(evt, `<strong>${esc(pShort(pid))}</strong> (${esc(pMeta(pid).name)})<br>Escaño ${idx} de ${tot} · Nivel: <strong>${tier}</strong>`);
          });
          el.addEventListener("mouseleave", hideTip);
        });

        // Stacked Majority Bar
        const bar = document.getElementById("majority-bar");
        bar.innerHTML = orderedParties.map(pid => {
          const n = hemiCounts[pid] || 0;
          if (!n) return "";
          const w = (n / 350) * 100;
          return `<div style="width:${w.toFixed(2)}%;background:${pColor(pid)};height:100%;" title="${esc(pShort(pid))}: ${n}"></div>`;
        }).join("");
      }

      // 52-PROVINCE CARTOGRAM & D'HONDT INSPECTOR
      function renderCartogram() {
        const grid = document.getElementById("cartogram-grid");
        grid.innerHTML = "";
        const sorted = [...DATA.constituencies].sort((a, b) => a.cpro.localeCompare(b.cpro));

        for (const con of sorted) {
          const meta = CONST_META[con.cpro] || { cartogram_row: 0, cartogram_col: 0, short_name: con.name };
          const div = document.createElement("div");
          div.className = "tile" + (con.cpro === STATE.selectedCpro ? " selected" : "");
          div.style.gridRow = String(Number(meta.cartogram_row) + 1);
          div.style.gridColumn = String(Number(meta.cartogram_col) + 1);

          // Leader & gap info
          const topParty = Object.entries(con.party_projections || {})
            .sort((a, b) => b[1].seats_mean - a[1].seats_mean || b[1].vote_share_mean - a[1].vote_share_mean)[0];
          const winnerId = topParty ? topParty[0] : "PSOE";
          const gapPp = con.last_seat_battle && con.last_seat_battle.runners_up && con.last_seat_battle.runners_up[0]
            ? Number(con.last_seat_battle.runners_up[0].vote_gap_pp) : 5.0;
          const enJuego = (con.seat_slots || []).filter(s => s.tier === "en_juego").length;

          let bg = pColor(winnerId);
          let ink = contrastInk(bg);
          let tagText = pShort(winnerId);

          if (STATE.mapMode === "margin") {
            const heat = Math.max(0, Math.min(1, 1 - gapPp / 3.5));
            bg = gapPp < 0.8 ? "#b91c1c" : gapPp < 2.0 ? "#ea580c" : gapPp < 3.5 ? "#f59e0b" : "#cbd5e1";
            ink = contrastInk(bg);
            tagText = `${gapPp.toFixed(1)}%`;
            div.style.opacity = String(0.7 + 0.3 * heat);
          } else if (STATE.mapMode === "en_juego") {
            bg = enJuego >= 3 ? "#7c2d12" : enJuego === 2 ? "#c2410c" : enJuego === 1 ? "#f97316" : "#e2e8f0";
            ink = contrastInk(bg);
            tagText = `${enJuego} jg`;
          }

          div.style.background = bg;
          div.style.color = ink;
          div.innerHTML = `
            <div class="tile-name">${esc(meta.short_name || con.name)}</div>
            <div class="tile-bottom">
              <span class="tile-seats">${con.seats_2026}</span>
              <span class="tile-tag">${esc(tagText)}</span>
            </div>
          `;
          div.addEventListener("click", () => {
            STATE.selectedCpro = con.cpro;
            renderCartogram();
            renderDistrictInspector();
          });
          div.addEventListener("mouseenter", evt => {
            showTip(evt, `<strong>${esc(con.name)} (${con.cpro})</strong> · ${con.seats_2026} escaños<br>Líder: <strong>${esc(pShort(winnerId))}</strong> (${fmtPct(topParty ? topParty[1].vote_share_mean : 0, 1)})<br>Margen último escaño: ${gapPp.toFixed(2)} pp · ${enJuego} en juego`);
          });
          div.addEventListener("mouseleave", hideTip);
          grid.appendChild(div);
        }
      }

      function renderBattlegrounds() {
        const tbody = document.querySelector("#battlegrounds-table tbody");
        const rows = (DATA.battlegrounds || []).slice(0, 8);
        tbody.innerHTML = rows.map(b => `
          <tr class="clickable" data-cpro="${esc(b.cpro)}">
            <td><strong>${esc(b.name)}</strong></td>
            <td class="num">${b.seats_2026}</td>
            <td><span class="party-chip"><span class="dot" style="background:${pColor(b.holder)}"></span>${esc(pShort(b.holder))}</span></td>
            <td><span class="party-chip"><span class="dot" style="background:${pColor(b.challenger)}"></span>${esc(pShort(b.challenger))}</span></td>
            <td class="num"><strong>+${Number(b.vote_gap_pp).toFixed(2)}</strong></td>
            <td class="num">${fmtInt(b.vote_gap_abs)}</td>
          </tr>
        `).join("");
