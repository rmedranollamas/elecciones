      function renderDistrictInspector() {
        const con = DATA.constituencies.find(c => c.cpro === STATE.selectedCpro) || DATA.constituencies[0];
        if (!con) return;
        const meta = CONST_META[con.cpro] || {};
        const isCity = con.cpro === "51" || con.cpro === "52";

        document.getElementById("insp-ccaa").textContent = `${meta.ccaa_name || "Comunidad Autónoma"} · CPRO ${con.cpro}`;
        document.getElementById("insp-title").textContent = `${con.name} — ${con.seats_2026} ${con.seats_2026 === 1 ? "escaño" : "escaños"}`;
        document.getElementById("insp-meta").innerHTML = `
          Participación est.: <strong>${fmtPct(con.turnout_mean, 1)}</strong> · En blanco: <strong>${fmtPct(con.blank_share, 2)}</strong><br>
          ${isCity ? "Ciudad Autónoma: 0% mayoría simple" : "Barrera legal LOREG Art. 163: <strong>3,0%</strong> s/ voto válido"}
        `;

        const lsb = con.last_seat_battle || { holder: "", cutoff_quotient: 0, runners_up: [] };
        const runnersHtml = (lsb.runners_up || []).map(r => `
          <span style="display:inline-flex;align-items:center;gap:4px;margin-right:10px;white-space:nowrap;">
            <span class="dot" style="background:${pColor(r.party)}"></span>
            <strong>${esc(pShort(r.party))}</strong>: +${Number(r.vote_gap_pp).toFixed(2)} pp (${fmtInt(r.vote_gap_abs)} votos)
          </span>
        `).join("") || "Sin aspirantes próximos";

        document.getElementById("insp-battle-box").innerHTML = `
          <div><strong>Último escaño (corte):</strong> <span class="party-chip"><span class="dot" style="background:${pColor(lsb.holder)}"></span>${esc(pShort(lsb.holder))}</span> · Cifra de reparto: <strong class="tabular">${fmtInt(lsb.cutoff_quotient)}</strong></div>
          <div style="margin-top:4px;"><strong>Aspirantes:</strong> ${runnersHtml}</div>
        `;

        // Party table
        const entries = Object.entries(con.party_projections || {}).sort(
          (a, b) => b[1].seats_mean - a[1].seats_mean || b[1].vote_share_mean - a[1].vote_share_mean
        );
        const tbody = document.querySelector("#insp-party-table tbody");
        tbody.innerHTML = entries.map(([pid, pr]) => {
          const belowBarrier = !isCity && pr.vote_share_mean < 0.03;
          return `
            <tr style="${belowBarrier ? "opacity:0.65;" : ""}">
              <td>
                <span class="party-chip"><span class="dot" style="background:${pColor(pid)}"></span>${esc(pShort(pid))}</span>
                ${belowBarrier ? '<span class="muted" style="font-size:10.5px;">(&lt;3%)</span>' : ""}
              </td>
              <td class="num">${fmtPct(pr.vote_share_mean, 1)} <span class="muted">(${fmtPct(pr.vote_share_p10, 1)}–${fmtPct(pr.vote_share_p90, 1)})</span></td>
              <td class="num"><strong>${fmtNum(pr.seats_mean, 2)}</strong></td>
              <td class="num">${pr.seats_p10}–${pr.seats_p90}</td>
              <td class="num">${pr.seguros} / ${pr.probables} / ${pr.en_juego}</td>
            </tr>
          `;
        }).join("");

        // Quotient bar chart comparing won vs next divisor cutoff
        const qList = [];
        for (const [pid, vals] of Object.entries(con.dhondt_quotients || {})) {
          (vals || []).forEach((qVal, dIdx) => {
            qList.push({ pid, div: dIdx + 1, qVal: Number(qVal) });
          });
        }
        qList.sort((a, b) => b.qVal - a.qVal || a.pid.localeCompare(b.pid));
        const topQ = qList.slice(0, Math.min(qList.length, con.seats_2026 + 4));
        const maxQ = Math.max(1, ...topQ.map(x => x.qVal));
        const qContainer = document.getElementById("insp-quotients");
        qContainer.innerHTML = topQ.map((q, rank) => {
          const won = rank < con.seats_2026;
          const pct = Math.max(2, (q.qVal / maxQ) * 100);
          return `
            <div class="q-row">
              <div style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                <span style="color:${won ? "#111" : "#78716c"};font-weight:${won ? 700 : 400};">${rank + 1}. ${esc(pShort(q.pid))}/${q.div}</span>
              </div>
              <div class="q-track" title="Cociente ${fmtInt(q.qVal)} (${won ? "Conseguido" : "Fuera"})">
                <div class="q-fill ${won ? "q-won" : "q-lost"}" style="width:${pct.toFixed(1)}%;background:${pColor(q.pid)}"></div>
              </div>
              <div class="num tabular" style="font-size:11.5px;color:${won ? "#111" : "#78716c"};">${fmtInt(q.qVal)}</div>
            </div>
          `;
        }).join("");
      }

      // 100-DAY NATIONAL POLLING TREND SVG
      function renderTrendToggles() {
        const parties = Object.keys((DATA.trend_series && DATA.trend_series.parties) || {});
        const wrap = document.getElementById("trend-toggles");
        wrap.innerHTML = parties.map(pid => `
          <button type="button" class="party-toggle ${STATE.hiddenTrendParties.has(pid) ? "off" : ""}" data-pid="${esc(pid)}">
            <span class="dot" style="background:${pColor(pid)}"></span>${esc(pShort(pid))}
          </button>
        `).join("");
        wrap.querySelectorAll(".party-toggle").forEach(btn => {
          btn.addEventListener("click", () => {
            const pid = btn.getAttribute("data-pid");
            if (STATE.hiddenTrendParties.has(pid)) STATE.hiddenTrendParties.delete(pid);
            else STATE.hiddenTrendParties.add(pid);
            renderTrendToggles();
            renderTrendChart();
          });
        });
      }

      function renderTrendChart() {
        const ts = DATA.trend_series || {};
        const dates = ts.dates || [];
        const partyData = ts.parties || {};
        const polls = ts.polls || [];
        const svg = document.getElementById("trend-svg");
        if (!dates.length) {
          svg.innerHTML = `<text x="460" y="160" text-anchor="middle" fill="#78716c">Sin serie histórica suficiente</text>`;
          return;
        }

        const W = 920, H = 330, padL = 46, padR = 24, padT = 20, padB = 34;
        const plotW = W - padL - padR, plotH = H - padT - padB;
        const parseD = dStr => new Date(dStr + "T12:00:00Z").getTime();
        const tMin = parseD(dates[0]);
        const tMax = parseD(dates[dates.length - 1]);
        const tSpan = Math.max(86400000, tMax - tMin);

        let yMax = 0.36;
        for (const [pid, ser] of Object.entries(partyData)) {
          if (STATE.hiddenTrendParties.has(pid)) continue;
          const p90Arr = ser.p90 || ser.mean || [];
          p90Arr.forEach(v => { if (v + 0.03 > yMax) yMax = Math.min(0.55, v + 0.03); });
        }
        const xPos = t => padL + ((t - tMin) / tSpan) * plotW;
        const yPos = v => padT + plotH * (1 - Math.max(0, Math.min(yMax, v)) / yMax);

        let html = "";
        // Horizontal gridlines
        for (let tick = 0; tick <= Math.floor(yMax * 100); tick += 5) {
          if (tick % 10 !== 0 && yMax > 0.32) continue;
          const y = yPos(tick / 100);
          html += `<line x1="${padL}" y1="${y.toFixed(1)}" x2="${W - padR}" y2="${y.toFixed(1)}" stroke="#e7e3da" stroke-width="1" />`;
          html += `<text x="${padL - 8}" y="${(y + 4).toFixed(1)}" text-anchor="end" font-size="11" fill="#78716c">${tick}%</text>`;
        }

        // Date ticks
        const tickIdxs = [0, Math.floor(dates.length / 3), Math.floor((2 * dates.length) / 3), dates.length - 1];
        [...new Set(tickIdxs)].forEach(i => {
          const x = xPos(parseD(dates[i]));
          html += `<line x1="${x.toFixed(1)}" y1="${padT}" x2="${x.toFixed(1)}" y2="${H - padB}" stroke="#f3f0e8" stroke-width="1" />`;
          html += `<text x="${x.toFixed(1)}" y="${H - 10}" text-anchor="middle" font-size="11" fill="#78716c">${esc(dates[i])}</text>`;
        });

        // Ribbons & lines
        for (const [pid, ser] of Object.entries(partyData)) {
          if (STATE.hiddenTrendParties.has(pid)) continue;
          const col = pColor(pid);
          const mean = ser.mean || [];
          const p10 = ser.p10 || mean;
          const p90 = ser.p90 || mean;
          if (mean.length !== dates.length) continue;

          // Confidence ribbon polygon
          const topPts = dates.map((d, i) => `${xPos(parseD(d)).toFixed(1)},${yPos(p90[i]).toFixed(1)}`);
          const botPts = dates.map((d, i) => `${xPos(parseD(d)).toFixed(1)},${yPos(p10[i]).toFixed(1)}`).reverse();
          html += `<polygon points="${topPts.concat(botPts).join(" ")}" fill="${col}" fill-opacity="0.12" />`;

          // Smoothed mean path
          const lineD = dates.map((d, i) => `${i === 0 ? "M" : "L"}${xPos(parseD(d)).toFixed(1)},${yPos(mean[i]).toFixed(1)}`).join(" ");
          html += `<path d="${lineD}" fill="none" stroke="${col}" stroke-width="2.4" stroke-linejoin="round" stroke-linecap="round" />`;

          // End label
          const lastVal = mean[mean.length - 1];
          const lx = xPos(parseD(dates[dates.length - 1]));
          const ly = yPos(lastVal);
          html += `<circle cx="${lx.toFixed(1)}" cy="${ly.toFixed(1)}" r="3.5" fill="${col}" />`;
        }

        // Poll scatter points
        for (const p of polls) {
          const px = xPos(parseD(p.date));
          if (px < padL || px > W - padR) continue;
          for (const [pid, val] of Object.entries(p.shares || {})) {
            if (STATE.hiddenTrendParties.has(pid) || !(pid in partyData)) continue;
            const py = yPos(val);
            const col = pColor(pid);
            if (p.is_cis) {
              html += `<polygon class="poll-pt" data-date="${esc(p.date)}" data-pollster="${esc(p.pollster)}" data-pid="${esc(pid)}" data-val="${val}" data-cis="1" points="${px.toFixed(1)},${(py - 4).toFixed(1)} ${(px + 4).toFixed(1)},${py.toFixed(1)} ${px.toFixed(1)},${(py + 4).toFixed(1)} ${(px - 4).toFixed(1)},${py.toFixed(1)}" fill="${col}" stroke="#111" stroke-width="0.9" fill-opacity="0.9" />`;
            } else {
              html += `<circle class="poll-pt" data-date="${esc(p.date)}" data-pollster="${esc(p.pollster)}" data-pid="${esc(pid)}" data-val="${val}" data-cis="0" cx="${px.toFixed(1)}" cy="${py.toFixed(1)}" r="2.7" fill="${col}" fill-opacity="0.58" />`;
            }
          }
        }

        svg.innerHTML = html;
        svg.querySelectorAll(".poll-pt").forEach(pt => {
          pt.addEventListener("mouseenter", evt => {
            const dStr = pt.getAttribute("data-date");
            const pol = pt.getAttribute("data-pollster");
            const pid = pt.getAttribute("data-pid");
            const val = Number(pt.getAttribute("data-val"));
            const cisTag = pt.getAttribute("data-cis") === "1" ? " · <em>CIS</em>" : "";
            showTip(evt, `<strong>${esc(pol)}</strong> (${dStr}${cisTag})<br>${esc(pShort(pid))}: <strong>${fmtPct(val, 1)}</strong>`);
          });
          pt.addEventListener("mouseleave", hideTip);
        });
      }

      // LIVE WHAT-IF SWING & ART. 99 PACT BUILDER
      function renderWhatIfSliders() {
        const vsMap = DATA.national.vote_shares;
        const container = document.getElementById("whatif-sliders");
        container.innerHTML = SLIDER_PARTIES.map(pid => {
          const basePct = Number((vsMap[pid] || {}).mean || 0) * 100;
          const dVal = Number(STATE.swings[pid] || 0);
          return `
            <div class="slider-item">
              <div class="slider-top">
                <span class="party-chip"><span class="dot" style="background:${pColor(pid)}"></span>${esc(pShort(pid))}</span>
                <span class="tabular" id="sl-lbl-${esc(pid)}">${basePct.toFixed(1)}% (${dVal >= 0 ? "+" : ""}${dVal.toFixed(1)} pp)</span>
              </div>
              <input type="range" min="-8" max="8" step="0.2" value="${dVal}" data-pid="${esc(pid)}" aria-label="Desplazamiento para ${esc(pShort(pid))}" />
            </div>
          `;
        }).join("");

        container.querySelectorAll("input[type='range']").forEach(inp => {
          inp.addEventListener("input", () => {
            const pid = inp.getAttribute("data-pid");
            STATE.swings[pid] = Number(inp.value);
            const basePct = Number((vsMap[pid] || {}).mean || 0) * 100;
            document.getElementById("sl-lbl-" + pid).textContent =
              `${Math.max(0.1, basePct + STATE.swings[pid]).toFixed(1)}% (${STATE.swings[pid] >= 0 ? "+" : ""}${STATE.swings[pid].toFixed(1)} pp)`;
            updateWhatIfAndPact();
          });
        });
      }

      function computeCurrentWhatIf() {
        const vsMap = DATA.national.vote_shares;
        const mult = {};
        let movedCount = 0;
        for (const pid of DATA.party_order) {
          const base = Number((vsMap[pid] || {}).mean || 0);
          const delta = Number(STATE.swings[pid] || 0) / 100;
          if (Math.abs(delta) > 1e-6) movedCount += 1;
          mult[pid] = base > 0.002 ? Math.max(0.05, (base + delta) / base) : 1.0;
        }
        const solved = solveShiftedChamber(mult);
        return { solved, mult, movedCount };
      }

      function renderPactBuilderRows() {
        const seatsMap = DATA.national.seats;
        const activePactParties = DATA.party_order.filter(pid => (seatsMap[pid] && seatsMap[pid].p95 > 0) || pid === "SALF");
        const box = document.getElementById("pact-builder-rows");
        box.innerHTML = activePactParties.map(pid => {
          const st = STATE.pactVotes[pid] || "no";
          return `
            <div class="pact-row" data-pid="${esc(pid)}">
              <span class="party-chip"><span class="dot" style="background:${pColor(pid)}"></span>${esc(pShort(pid))}</span>
              <span class="muted tabular" id="pact-seat-cnt-${esc(pid)}" style="font-size:12px;margin-left:auto;">—</span>
              <div class="tri-pill">
                <button type="button" class="tri-btn yes ${st === "yes" ? "active" : ""}" data-v="yes">Sí</button>
                <button type="button" class="tri-btn abs ${st === "abs" ? "active" : ""}" data-v="abs">Abst</button>
                <button type="button" class="tri-btn no ${st === "no" ? "active" : ""}" data-v="no">No</button>
              </div>
            </div>
          `;
        }).join("");

        box.querySelectorAll(".tri-btn").forEach(btn => {
          btn.addEventListener("click", () => {
            const row = btn.closest(".pact-row");
            const pid = row.getAttribute("data-pid");
            STATE.pactVotes[pid] = btn.getAttribute("data-v");
            row.querySelectorAll(".tri-btn").forEach(b => b.classList.remove("active"));
            btn.classList.add("active");
            updateWhatIfAndPact();
          });
        });
      }

      function applyPactPreset(presetKey) {
        const sets = {
          pp_vox: { yes: ["PP", "UPN_PP", "VOX"], abs: ["CCA"] },
          pp_minority: { yes: ["PP", "UPN_PP", "CCA"], abs: ["VOX", "SALF", "PNV", "JUNTS"] },
          prog_sin_junts: { yes: ["PSOE", "FA", "PODEMOS", "COMPROMIS_FV", "ADELANTE", "ERC", "EH_BILDU", "PNV", "BNG", "UPC", "ARA_MES"], abs: ["JUNTS", "CCA"] },
          plurinacional: { yes: ["PSOE", "FA", "PODEMOS", "COMPROMIS_FV", "ADELANTE", "ERC", "EH_BILDU", "PNV", "BNG", "JUNTS", "UPC", "ARA_MES"], abs: ["CCA"] },
          gran_coalicion: { yes: ["PP", "UPN_PP", "PSOE"], abs: [] },
        };
        const cfg = sets[presetKey] || { yes: [], abs: [] };
        DATA.party_order.forEach(pid => {
          if (cfg.yes.includes(pid)) STATE.pactVotes[pid] = "yes";
          else if (cfg.abs.includes(pid)) STATE.pactVotes[pid] = "abs";
          else STATE.pactVotes[pid] = "no";
        });
        renderPactBuilderRows();
        updateWhatIfAndPact();
      }

      function updateWhatIfAndPact() {
        const vsMap = DATA.national.vote_shares;
        const seatsMap = DATA.national.seats;
        const { solved, movedCount } = computeCurrentWhatIf();
        const baseDet = movedCount === 0
          ? solved
          : solveShiftedChamber(Object.fromEntries(DATA.party_order.map(p => [p, 1.0])));

        // Update What-If summary & table
        document.getElementById("whatif-summary").textContent =
          movedCount === 0 ? "Escenario base determinista (0 variaciones)" : `${movedCount} partidos ajustados · 350 escaños LOREG`;

        const wiRows = DATA.party_order.filter(pid => (solved.natSeats[pid] || 0) > 0 || (seatsMap[pid] && seatsMap[pid].p95 > 0) || Math.abs(STATE.swings[pid] || 0) > 0.05);
        wiRows.sort((a, b) => (solved.natSeats[b] || 0) - (solved.natSeats[a] || 0) || (solved.natShares[b] || 0) - (solved.natShares[a] || 0));

        document.querySelector("#whatif-table tbody").innerHTML = wiRows.slice(0, 14).map(pid => {
          const bVs = Number(baseDet.natShares[pid] || (vsMap[pid] || {}).mean || 0);
          const sVs = Number(solved.natShares[pid] || 0);
          const bSeats = Number(baseDet.natSeats[pid] || 0);
          const sSeats = Number(solved.natSeats[pid] || 0);
          const diff = sSeats - bSeats;
          const diffStr = diff > 0 ? `+${diff}` : String(diff);
          const diffCol = diff > 0 ? "#15803d" : diff < 0 ? "#b91c1c" : "#78716c";
          return `
            <tr>
              <td><span class="party-chip"><span class="dot" style="background:${pColor(pid)}"></span>${esc(pShort(pid))}</span></td>
              <td class="num">${fmtPct(bVs, 1)}</td>
              <td class="num"><strong>${fmtPct(sVs, 1)}</strong></td>
              <td class="num"><strong>${sSeats}</strong></td>
              <td class="num" style="color:${diffCol};font-weight:700;">${diffStr}</td>
            </tr>
          `;
        }).join("");

        // Compute deterministic tally in custom Pact Builder + Monte Carlo approx across 200 sim_sample rows shifted by user swing
        let yesDet = 0, absDet = 0, noDet = 0;
        const totalDet = Object.values(solved.natSeats).reduce((a, b) => a + b, 0) || 350;
        for (const pid of DATA.party_order) {
          const sc = solved.natSeats[pid] || 0;
          const v = STATE.pactVotes[pid] || "no";
          if (v === "yes") yesDet += sc;
          else if (v === "abs") absDet += sc;
          else noDet += sc;
          const cntEl = document.getElementById("pact-seat-cnt-" + pid);
          if (cntEl) cntEl.textContent = `${sc} esc.`;
        }

        // Shift delta per party on sim_sample proportional to deterministic delta (exact on 0-swing baseline)
        const detShiftSeats = {};
        DATA.party_order.forEach(p => { detShiftSeats[p] = (solved.natSeats[p] || 0) - (baseDet.natSeats[p] || 0); });

        let pass1 = 0, pass2 = 0;
        const sample = DATA.sim_sample || [];
        for (const draw of sample) {
          let sy = 0, sn = 0;
          for (const [pid, rawS] of Object.entries(draw.seats || {})) {
            const sAdj = Math.max(0, Number(rawS) + (detShiftSeats[pid] || 0));
            const v = STATE.pactVotes[pid] || "no";
            if (v === "yes") sy += sAdj;
            else if (v === "no") sn += sAdj;
          }
          if (sy >= 176) pass1 += 1;
          if (sy > sn) pass2 += 1;
        }
        const nS = Math.max(1, sample.length);
        const prob1 = (pass1 / nS) * 100;
        const prob2 = (pass2 / nS) * 100;
        const margin2 = yesDet - noDet;

        document.getElementById("custom-pact-result").innerHTML = `
          <div style="border:1px solid var(--border);border-radius:5px;padding:10px;background:${yesDet >= 176 ? "#f0fdf4" : "#faf9f5"};">
            <div style="font-size:11px;font-weight:700;text-transform:uppercase;color:var(--ink-muted);">1.ª Vuelta (&ge; 176 de ${totalDet})</div>
            <div class="serif tabular" style="font-size:1.35rem;font-weight:700;margin:2px 0;color:${yesDet >= 176 ? "#15803d" : "#121212"};">${yesDet} Sí <span style="font-size:12px;font-weight:600;">(${prob1.toFixed(0)}% MC)</span></div>
            <div class="muted tabular" style="font-size:11.5px;">${yesDet >= 176 ? "Supera mayoría absoluta" : `Faltan ${176 - yesDet} escaños`}</div>
          </div>
          <div style="border:1px solid var(--border);border-radius:5px;padding:10px;background:${margin2 > 0 ? "#f0fdf4" : "#fef2f2"};">
            <div style="font-size:11px;font-weight:700;text-transform:uppercase;color:var(--ink-muted);">2.ª Vuelta (Sí &gt; No)</div>
            <div class="serif tabular" style="font-size:1.35rem;font-weight:700;margin:2px 0;color:${margin2 > 0 ? "#15803d" : "#b91c1c"};">${margin2 >= 0 ? "+" : ""}${margin2} <span style="font-size:12px;font-weight:600;">(${prob2.toFixed(0)}% MC)</span></div>
            <div class="muted tabular" style="font-size:11.5px;">Sí ${yesDet} · Abst ${absDet} · No ${noDet}</div>
          </div>
        `;
      }

      function renderInvestitureMcTable() {
        const tbody = document.querySelector("#investiture-mc-table tbody");
        const inv = DATA.investiture || { first_ballot: {}, second_ballot: {} };
        const rows = [];
        for (const p of Object.values(inv.first_ballot || {})) {
          rows.push(`
            <tr>
              <td><span class="badge">1.ª &ge;176</span></td>
              <td><strong>${esc(p.label)}</strong></td>
              <td class="num"><strong>${(p.prob * 100).toFixed(1)}%</strong></td>
              <td class="num">${p.median_seats} (${p.p10}–${p.p90})</td>
            </tr>
          `);
        }
        for (const s of Object.values(inv.second_ballot || {})) {
          rows.push(`
            <tr>
              <td><span class="badge" style="background:#eef2ff;">2.ª Sí&gt;No</span></td>
              <td>${esc(s.label)}</td>
              <td class="num"><strong>${(s.prob * 100).toFixed(1)}%</strong></td>
              <td class="num">${s.median_margin >= 0 ? "+" : ""}${s.median_margin}</td>
            </tr>
          `);
        }
        tbody.innerHTML = rows.join("");
      }

      // POLLSTER SCORECARD TABLE
      function renderPollsterTable() {
        const q = STATE.pollsterFilter.trim().toLowerCase();
        const key = STATE.pollsterSortKey;
        const asc = STATE.pollsterSortAsc;
        const list = (DATA.pollster_scorecard || []).filter(r => !q || String(r.pollster).toLowerCase().includes(q));
        list.sort((a, b) => {
          const va = a[key], vb = b[key];
          if (typeof va === "string" || typeof vb === "string") {
            return asc ? String(va).localeCompare(String(vb)) : String(vb).localeCompare(String(va));
          }
          return asc ? Number(va) - Number(vb) : Number(vb) - Number(va);
        });
        const fmtHouse = v => {
          const x = Number(v || 0);
          const col = x > 0.35 ? "#15803d" : x < -0.35 ? "#b91c1c" : "#57534e";
          return `<span style="color:${col};font-weight:${Math.abs(x) > 0.35 ? 700 : 400};">${x >= 0 ? "+" : ""}${x.toFixed(2)}</span>`;
        };
        document.querySelector("#pollster-table tbody").innerHTML = list.map(r => `
          <tr>
            <td><strong>${esc(r.pollster)}</strong></td>
            <td><span class="grade-pill grade-${esc(r.grade)}">${esc(r.grade)}</span></td>
            <td class="num">${r.n_elections}</td>
            <td class="num">${r.n_polls_2026}</td>
            <td class="num"><strong>${Number(r.shrunk_mae).toFixed(2)}</strong></td>
            <td class="num">${Number(r.herding_ratio).toFixed(2)}</td>
            <td class="num">${fmtHouse(r.delta_PP)}</td>
            <td class="num">${fmtHouse(r.delta_PSOE)}</td>
            <td class="num">${fmtHouse(r.delta_VOX)}</td>
            <td class="num">${fmtHouse(r.delta_FA)}</td>
            <td class="num">${fmtHouse(r.delta_PODEMOS)}</td>
          </tr>
        `).join("");
      }

      // LOOCV BACKTEST DIAGNOSTICS
      function renderBacktest() {
        const bt = DATA.backtest;
        if (!bt) return;
        const srcModels = STATE.btHorizon === "global" ? bt.models : ((bt.horizons || {})[STATE.btHorizon] || bt.models);
        const labels = { kernel: "Stage 1A Kernel", state_space: "Stage 1B Espacio-Estado", ensemble: "Ensemble Calibrado" };

        document.querySelector("#bt-models-table tbody").innerHTML = ["ensemble", "state_space", "kernel"]
          .filter(k => k in srcModels)
          .map(k => {
            const m = srcModels[k];
            return `
              <tr style="${k === "ensemble" ? "background:#f8f6f0;font-weight:600;" : ""}">
                <td><strong>${labels[k] || k}</strong></td>
                <td class="num">${Number(m.vote_mae_national).toFixed(2)} pp</td>
                <td class="num">${Number(m.seat_mae_provincial).toFixed(3)}</td>
                <td class="num">${Number(m.seat_mae_national).toFixed(2)}</td>
                <td class="num">${Number(m.brier_score).toFixed(4)}</td>
                <td class="num">${(m.coverage_80_provincial_seats * 100).toFixed(1)}% / ${(m.coverage_80_national_seats * 100).toFixed(1)}%</td>
                <td class="num">${(m.coverage_95_provincial_seats * 100).toFixed(1)}% / ${(m.coverage_95_national_seats * 100).toFixed(1)}%</td>
              </tr>
            `;
          }).join("");

        const cp = bt.calibrated_parameters || {};
        const cov = cp.covariance || {};
        document.getElementById("bt-cal-params").innerHTML =
          `<strong>Parámetros calibrados:</strong> Pesos K/EE = <strong>${cp.ensemble_weight_kernel} / ${cp.ensemble_weight_state_space}</strong> · Student-t df = <strong>${cov.student_t_df}</strong> · &sigma;<sub>nac</sub> = <strong>${cov.nat_scale}</strong> · &sigma;<sub>CCAA</sub> = <strong>${cov.ccaa_scale}</strong> · &sigma;<sub>prov</sub> = <strong>${cov.prov_scale}</strong>`;

        const tierInfo = [
          ["seguro", "Seguro (≥99%)", "#15803d"],
          ["probable", "Probable (75–99%)", "#0284c7"],
          ["en_juego", "En juego (25–75%)", "#d97706"],
          ["remoto", "Remoto (5–25%)", "#64748b"],
        ];
        document.getElementById("bt-tiers-bars").innerHTML = tierInfo.map(([k, lbl, col]) => {
          const tb = (bt.tier_calibration || {})[k] || { hits: 0, total: 0, hit_rate: 0 };
          const pct = Number(tb.hit_rate || 0) * 100;
          return `
            <div style="margin-bottom:8px;">
              <div style="display:flex;justify-content:space-between;font-size:12px;">
                <span><strong>${lbl}</strong></span>
                <span class="tabular"><strong>${pct.toFixed(1)}%</strong> empírico (${tb.hits} / ${tb.total})</span>
              </div>
              <div style="height:10px;background:#ece8df;border-radius:999px;overflow:hidden;margin-top:3px;">
                <div style="width:${pct.toFixed(1)}%;height:100%;background:${col};border-radius:999px;"></div>
              </div>
            </div>
          `;
        }).join("");

        document.querySelector("#bt-elections-table tbody").innerHTML = Object.entries(bt.per_election || {}).map(([eid, m]) => `
          <tr>
            <td><strong>${esc(eid)}</strong></td>
            <td class="num">${Number(m.vote_mae_national).toFixed(2)} pp</td>
            <td class="num">${Number(m.seat_mae_provincial).toFixed(3)}</td>
            <td class="num">${Number(m.seat_mae_national).toFixed(2)}</td>
            <td class="num">${Number(m.brier_score).toFixed(4)}</td>
            <td class="num">${(m.coverage_80_provincial_seats * 100).toFixed(1)}% / ${(m.coverage_95_provincial_seats * 100).toFixed(1)}%</td>
          </tr>
        `).join("");
      }

      // EVENT WIRING
      document.querySelectorAll("#engine-toggle .seg-btn").forEach(btn => {
        btn.addEventListener("click", () => {
          STATE.engine = btn.getAttribute("data-engine");
          document.querySelectorAll("#engine-toggle .seg-btn").forEach(b => b.classList.toggle("active", b === btn));
          renderHemicycleAndNational();
        });
      });

      document.querySelectorAll("#cis-toggle .seg-btn").forEach(btn => {
        btn.addEventListener("click", () => {
          STATE.cis = btn.getAttribute("data-cis");
          document.querySelectorAll("#cis-toggle .seg-btn").forEach(b => b.classList.toggle("active", b === btn));
          renderHemicycleAndNational();
        });
      });

      document.getElementById("btn-reset-mode").addEventListener("click", () => {
        STATE.engine = BASE_ENGINE;
        STATE.cis = BASE_CIS;
        document.querySelectorAll("#engine-toggle .seg-btn").forEach(b => b.classList.toggle("active", b.getAttribute("data-engine") === STATE.engine));
        document.querySelectorAll("#cis-toggle .seg-btn").forEach(b => b.classList.toggle("active", b.getAttribute("data-cis") === STATE.cis));
        renderHemicycleAndNational();
      });

      document.querySelectorAll("#map-mode-toggle .seg-btn").forEach(btn => {
        btn.addEventListener("click", () => {
          STATE.mapMode = btn.getAttribute("data-mapmode");
          document.querySelectorAll("#map-mode-toggle .seg-btn").forEach(b => b.classList.toggle("active", b === btn));
          renderCartogram();
        });
      });

      document.getElementById("btn-reset-sliders").addEventListener("click", () => {
        SLIDER_PARTIES.forEach(p => { STATE.swings[p] = 0.0; });
        renderWhatIfSliders();
        updateWhatIfAndPact();
      });

      document.querySelectorAll("#pact-presets button").forEach(btn => {
        btn.addEventListener("click", () => applyPactPreset(btn.getAttribute("data-preset")));
      });

      document.getElementById("pollster-search").addEventListener("input", evt => {
        STATE.pollsterFilter = evt.target.value || "";
        renderPollsterTable();
      });

      document.querySelectorAll("#pollster-table th.sortable").forEach(th => {
        th.addEventListener("click", () => {
          const k = th.getAttribute("data-sort");
          if (STATE.pollsterSortKey === k) STATE.pollsterSortAsc = !STATE.pollsterSortAsc;
          else {
            STATE.pollsterSortKey = k;
            STATE.pollsterSortAsc = (k === "pollster" || k === "shrunk_mae" || k === "grade");
          }
          renderPollsterTable();
        });
      });

      document.querySelectorAll("#bt-horizon-toggle .seg-btn").forEach(btn => {
        btn.addEventListener("click", () => {
          STATE.btHorizon = btn.getAttribute("data-hor");
          document.querySelectorAll("#bt-horizon-toggle .seg-btn").forEach(b => b.classList.toggle("active", b === btn));
          renderBacktest();
        });
      });

      // INITIAL RENDER
      renderHemicycleAndNational();
      renderCartogram();
      renderBattlegrounds();
      renderDistrictInspector();
      renderTrendToggles();
      renderTrendChart();
      renderWhatIfSliders();
      renderPactBuilderRows();
      updateWhatIfAndPact();
      renderInvestitureMcTable();
      renderPollsterTable();
      renderBacktest();
    })();
  </script>
</body>
</html>
